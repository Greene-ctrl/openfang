# OpenFang Agent OS — Configuration
# Set default model and external memory providers.

api_listen = "0.0.0.0:4200"

[default_model]
provider = "openai"
model = "alias-large"
api_key_env = "OPENAI_API_KEY"
base_url = "https://api.helmholtz-blablador.fz-juelich.de/v1"

[memory]
decay_rate = 0.1
embedding_provider = "openai"
embedding_model = "alias-large"
embedding_api_key_env = "OPENAI_API_KEY"

[web]
provider = "searxng"

# External MCP Servers
[[mcp_servers]]
name = "mem0"
transport = { type = "sse", url = "https://harvesthealth-memo.hf.space/mcp-mem0/mcp" }

[[mcp_servers]]
name = "cognee"
transport = { type = "rest", url = "https://harvesthealth-cognee-mco.hf.space" }

[network]
enabled = false

[google]
# Pre-configured via Docker environment
# GOOGLE_WORKSPACE_CLI_TOKEN = "..."
